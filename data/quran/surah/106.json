{"id":106,"verses":[{"n":1,"g":6194,"tr":"Lieelafi qurayshin","en":"For the accustomed security of the Quraysh","w":[{"a":"لِإِيلَـٰفِ","t":"liīlāfi","e":"For (the) familiarity","j":[["لِإِيلَ"],["ـٰ","madda_normal"],["فِ"]],"s":550,"f":2380},{"a":"قُرَيْشٍ","t":"qurayshin","e":"(of the) Quraish","j":[["قُر"],["َي","madda_permissible"],["ۡشٍ"]],"s":2390,"f":4880}],"p":602},{"n":2,"g":6195,"tr":"Eelafihim rihlata alshshitai waalssayfi","en":"Their accustomed security [in] the caravan of winter and summer","w":[{"a":"إِۦلَـٰفِهِمْ","t":"īlāfihim","e":"Their familiarity","j":[["إ"],["ِۦ","madda_normal"],["لَ"],["ـٰ","madda_normal"],["فِهِمۡ"]],"s":500,"f":2760},{"a":"رِحْلَةَ","t":"riḥ'lata","e":"(with the) journey","j":"رِحۡلَةَ","s":2770,"f":4190},{"a":"ٱلشِّتَآءِ","t":"l-shitāi","e":"(of) winter","j":[["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["شِّت"],["َا","madda_obligatory_mottasel"],["ٓءِ"]],"s":4200,"f":7090},{"a":"وَٱلصَّيْفِ","t":"wal-ṣayfi","e":"and summer","j":[["وَ"],["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["صّ"],["َي","madda_permissible"],["ۡفِ"]],"s":7100,"f":9870}],"p":602},{"n":3,"g":6196,"tr":"FalyaAAbudoo rabba hatha albayti","en":"Let them worship the Lord of this House","w":[{"a":"فَلْيَعْبُدُوا۟","t":"falyaʿbudū","e":"So let them worship","j":[["فَلۡيَعۡبُدُو"],["اۡ","slnt"]],"s":900,"f":3190},{"a":"رَبَّ","t":"rabba","e":"(the) Lord","j":"رَبَّ","s":3200,"f":4290},{"a":"هَـٰذَا","t":"hādhā","e":"(of) this","j":[["هَ"],["ـٰ","madda_normal"],["ذَا"]],"s":4300,"f":5470},{"a":"ٱلْبَيْتِ","t":"l-bayti","e":"House","j":[["ٱ","ham_wasl"],["لۡب"],["َي","madda_permissible"],["ۡتِ"]],"s":5480,"f":8180}],"p":602},{"n":4,"g":6197,"tr":"Allathee atAAamahum min jooAAin waamanahum min khawfin","en":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear","w":[{"a":"ٱلَّذِىٓ","t":"alladhī","e":"The One Who","j":[["ٱلَّذ"],["ِىٓ","madda_obligatory_monfasel"]],"s":300,"f":2670},{"a":"أَطْعَمَهُم","t":"aṭʿamahum","e":"feeds them","j":