{"id":93,"verses":[{"n":1,"g":6080,"tr":"Waaldduha","en":"By the morning brightness","w":[{"a":"وَٱلضُّحَىٰ","t":"wal-ḍuḥā","e":"By the morning brightness","j":[["وَ"],["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["ضُّحَىٰ"]],"s":100,"f":2250}],"p":596},{"n":2,"g":6081,"tr":"Waallayli itha saja","en":"And [by] the night when it covers with darkness","w":[{"a":"وَٱلَّيْلِ","t":"wa-al-layli","e":"And the night","j":[["وَ"],["ٱ","ham_wasl"],["لَّيۡلِ"]],"s":150,"f":1520},{"a":"إِذَا","t":"idhā","e":"when","j":"إِذَا","s":1530,"f":2520},{"a":"سَجَىٰ","t":"sajā","e":"it covers with darkness","j":"سَجَىٰ","s":2530,"f":3800}],"p":596},{"n":3,"g":6082,"tr":"Ma waddaAAaka rabbuka wama qala","en":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you]","w":[{"a":"مَا","t":"mā","e":"Not","j":"مَا","s":60,"f":660},{"a":"وَدَّعَكَ","t":"waddaʿaka","e":"has forsaken you","j":"وَدَّعَكَ","s":670,"f":2370},{"a":"رَبُّكَ","t":"rabbuka","e":"your Lord","j":"رَبُّكَ","s":2380,"f":3750},{"a":"وَمَا","t":"wamā","e":"and not","j":"وَمَا","s":3760,"f":4710},{"a":"قَلَىٰ","t":"qalā","e":"He is displeased","j":"قَلَىٰ","s":4720,"f":5790}],"p":596},{"n":4,"g":6083,"tr":"Walalakhiratu khayrun laka mina aloola","en":"And the Hereafter is better for you than the first [life]","w":[{"a":"وَلَلْـَٔاخِرَةُ","t":"walalākhiratu","e":"And surely the Hereafter","j":"وَلَلۡأَخِرَةُ","s":100,"f":2580},{"a":"خَيْرٌۭ","t":"khayrun","e":"(is) better","j":[["خَيۡ"],["رٌ","idgham_wo_ghunnah"]],"s":2590,"f":3730},{"a":"لَّكَ","t":"laka","e":"for you","j":[["ل","idgham_wo_ghunnah"],["َّكَ"]],"s":3740,"f":4710},{"a":"مِنَ","t":"mina","e":"than","j":"مِنَ","s":4720,"f":5340},{"a":"ٱلْأُولَىٰ","t":"l-ūlā","e":"the first","j":[["ٱ","ham_wasl"],["لۡأُولَىٰ"]],"s":5350,"f":7240}],"p":596},{"n":5,"g":6084,"tr":"Walasawfa yuAAteeka rabbuka fatarda","en":"And your Lord is going to give you, and you will be satisfied","w":[{"a":"وَلَسَوْفَ","t":"walasawfa","e":"And soon","j":"وَلَسَوۡفَ","s":450,"f":1950},{"a":"يُعْطِيكَ","t":"yuʿ'ṭīka","e":"will give you","j":"يُعۡطِيكَ","s":1960,"f":3670},{"a":"رَبُّكَ","t":"rabbuka","e":"your Lord","j":"رَبُّكَ","s":3680,"f":5160},{"a":"فَتَرْضَىٰٓ","t":"fatarḍā","e":"then you will be satisfied","j":"فَتَرۡضَىٰٓ","s":5170,"f":7070}],"p":596},{"n":6,"g":6085,"tr":"Alam yajidka yateeman faawa","en":"Did He not find you an orphan and give [you] refuge","w":[{"a":"أَلَمْ","t":"alam","e":"Did not","j":"أَلَمۡ","s":200,"f":840},{"a":"يَجِدْكَ","t":"yajid'ka","e":"He find you","j":[["يَجِ"],["دۡ","qalaqah"],["كَ"]],"s":850,"f":2310},{"a":"يَتِيمًۭا","t":"yatīman","e":"an orphan","j":[["يَتِي"],["مًا","ikhafa"]],"s":2320,"f":4430},{"a":"فَـَٔاوَىٰ","t":"faāwā","e":"and give shelter","j":[["ف","ikhafa"],["َـَٔـاوَىٰ"]],"s":4440,"f":6350}],"p":596},{"n":7,"g":6086,"tr":"Wawajadaka dallan fahada","en":"And He found you lost and guided [you]","w":[{"a":"وَوَجَدَكَ","t":"wawajadaka","e":"And He found you","j":"وَوَجَدَكَ","s":250,"f":1740},{"a":"ضَآلًّۭا","t":"ḍāllan","e":"lost","j":[["ضَآل"],["اًّ","ikhafa"]],"s":1750,"f":6500},{"a":"فَهَدَىٰ","t":"fahadā","e":"so He guided","j":[["ف","ikhafa"],["َهَدَىٰ"]],"s":6510,"f":8030}],"p":596},{"n":8,"g":6087,"tr":"Wawajadaka AAailan faaghna","en":"And He found you poor and made [you] self-sufficient","w":[{"a":"وَوَجَدَكَ","t":"wawajadaka","e":"And He found you","j":"وَوَجَدَكَ","s":200,"f":1660},{"a":"عَآئِلًۭا","t":"ʿāilan","e":"in need","j":[["ع"],["َا","madda_obligatory_mottasel"],["ٓئِل"],["اً","ikhafa"]],"s":1670,"f":4740},{"a":"فَأَغْنَىٰ","t":"fa-aghnā","e":"so He made self-sufficient","j":[["ف","ikhafa"],["َأَغۡنَىٰ"]],"s":4750,"f":6760}],"p":596},{"n":9,"g":6088,"tr":"Faamma alyateema fala taqhar","en":"So as for the orphan, do not oppress [him]","w":[{"a":"فَأَمَّا","t":"fa-ammā","e":"So as for","j":[["فَأَ"],["مّ","ghunnah"],["َا"]],"s":600,"f":1940},{"a":"ٱلْيَتِيمَ","t":"l-yatīma","e":"the orphan","j":[["ٱ","ham_wasl"],["لۡيَتِيمَ"]],"s":1950,"f":3730},{"a":"فَلَا","t":"falā","e":"then (do) not","j":"فَلَا","s":3740,"f":4790},{"a":"تَقْهَرْ","t":"taqhar","e":"oppress","j":[["تَ"],["قۡ","qalaqah"],["هَرۡ"]],"s":4800,"f":6280}],"p":596},{"n":10,"g":6089,"tr":"Waamma alssaila fala tanhar","en":"And as for the petitioner, do not repel [him]","w":[{"a":"وَأَمَّا","t":"wa-ammā","e":"And as for","j":[["وَأَ"],["مّ","ghunnah"],["َا"]],"s":420,"f":2250},{"a":"ٱلسَّآئِلَ","t":"l-sāila","e":"one who asks","j":[["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["سّ"],["َا","madda_obligatory_mottasel"],["ٓئِلَ"]],"s":2260,"f":5030},{"a":"فَلَا","t":"falā","e":"then (do) not","j":"فَلَا","s":5040,"f":6210},{"a":"تَنْهَرْ","t":"tanhar","e":"repel","j":"تَنۡهَرۡ","s":6220,"f":7710}],"p":596},{"n":11,"g":6090,"tr":"Waamma biniAAmati rabbika fahaddith","en":"But as for the favor of your Lord, report [it]","w":[{"a":"وَأَمَّا","t":"wa-ammā","e":"But as for","j":[["وَأَ"],["مّ","ghunnah"],["َا"]],"s":60,"f":2080},{"a":"بِنِعْمَةِ","t":"biniʿ'mati","e":"(the) Favor","j":"بِنِعۡمَةِ","s":2090,"f":3840},{"a":"رَبِّكَ","t":"rabbika","e":"(of) your Lord","j":"رَبِّكَ","s":3850,"f":5470},{"a":"فَحَدِّثْ","t":"faḥaddith","e":"narrate","j":"فَحَدِّثۡ","s":5480,"f":7130}],"p":596}]}