{"id":112,"verses":[{"n":1,"g":6222,"tr":"Qul huwa Allahu ahadun","en":"Say, \"He is Allah, [who is] One","w":[{"a":"قُلْ","t":"qul","e":"Say","j":"قُلۡ","s":850,"f":1370},{"a":"هُوَ","t":"huwa","e":"He","j":"هُوَ","s":1380,"f":2090},{"a":"ٱللَّهُ","t":"l-lahu","e":"(is) Allah","j":[["ٱ","ham_wasl"],["للَّهُ"]],"s":2100,"f":3710},{"a":"أَحَدٌ","t":"aḥadun","e":"the One","j":[["أَحَ"],["د","qalaqah"],["ٌ"]],"s":3720,"f":4610}]},{"n":2,"g":6223,"tr":"Allahu alssamadu","en":"Allah, the Eternal Refuge","w":[{"a":"ٱللَّهُ","t":"al-lahu","e":"Allah","j":"ٱللَّهُ","s":1610,"f":2580},{"a":"ٱلصَّمَدُ","t":"l-ṣamadu","e":"the Eternal, the Absolute","j":[["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["صَّمَ"],["د","qalaqah"],["ُ"]],"s":2590,"f":3760}]},{"n":3,"g":6224,"tr":"Lam yalid walam yooladu","en":"He neither begets nor is born","w":[{"a":"لَمْ","t":"lam","e":"Not","j":"لَمۡ","s":450,"f":910},{"a":"يَلِدْ","t":"yalid","e":"He begets","j":[["يَلِ"],["دۡ","qalaqah"]],"s":920,"f":2080},{"a":"وَلَمْ","t":"walam","e":"and not","j":"وَلَمۡ","s":2090,"f":3380},{"a":"يُولَدْ","t":"yūlad","e":"He is begotten","j":[["يُولَ"],["دۡ","qalaqah"]],"s":3390,"f":4900}]},{"n":4,"g":6225,"tr":"Walam yakun lahu kufuwan ahadun","en":"Nor is there to Him any equivalent","w":[{"a":"وَلَمْ","t":"walam","e":"And not","j":"وَلَمۡ","s":200,"f":1140},{"a":"يَكُن","t":"yakun","e":"is","j":[["يَك"],["ُن","idgham_wo_ghunnah"]],"s":1150,"f":1970},{"a":"لَّهُۥ","t":"lahu","e":"for Him","j":[["ل","idgham_wo_ghunnah"],["َّهُ"],["ۥ","madda_normal"]],"s":1980,"f":3600},{"a":"كُفُوًا","t":"kufuwan","e":"equivalent","j":"كُفُوًا","s":3610,"f":5280},{"a":"أَحَدٌۢ","t":"aḥadun","e":"any [one]","j":[["أَحَ"],["د","qalaqah"],["ُۢ"]],"s":5290,"f":6150}]}]}