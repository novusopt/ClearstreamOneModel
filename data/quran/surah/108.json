{"id":108,"verses":[{"n":1,"g":6205,"tr":"Inna aAAtaynaka alkawthara","en":"Indeed, We have granted you, [O Muhammad], al-Kawthar","w":[{"a":"إِنَّآ","t":"innā","e":"Indeed, We","j":[["إِ"],["نّ","ghunnah"],["َآ","madda_obligatory_monfasel"]],"s":330,"f":1540},{"a":"أَعْطَيْنَـٰكَ","t":"aʿṭaynāka","e":"We have given you","j":[["أَعۡطَيۡنَ"],["ـٰ","madda_normal"],["كَ"]],"s":1550,"f":5650},{"a":"ٱلْكَوْثَرَ","t":"l-kawthara","e":"Al-Kauthar","j":[["ٱ","ham_wasl"],["لۡكَوۡثَرَ"]],"s":5660,"f":7460}],"p":602},{"n":2,"g":6206,"tr":"Fasalli lirabbika wainhar","en":"So pray to your Lord and sacrifice [to Him alone]","w":[{"a":"فَصَلِّ","t":"faṣalli","e":"So pray","j":"فَصَلِّ","s":30,"f":1330},{"a":"لِرَبِّكَ","t":"lirabbika","e":"to your Lord","j":"لِرَبِّكَ","s":1340,"f":3180},{"a":"وَٱنْحَرْ","t":"wa-in'ḥar","e":"and sacrifice","j":[["وَ"],["ٱ","ham_wasl"],["نۡحَرۡ"]],"s":3190,"f":4720}],"p":602},{"n":3,"g":6207,"tr":"Inna shaniaka huwa alabtaru","en":"Indeed, your enemy is the one cut off","w":[{"a":"إِنَّ","t":"inna","e":"Indeed","j":[["إِ"],["نّ","ghunnah"],["َ"]],"s":30,"f":1390},{"a":"شَانِئَكَ","t":"shāni-aka","e":"your enemy","j":"شَانِئَكَ","s":1400,"f":3220},{"a":"هُوَ","t":"huwa","e":"he (is)","j":"هُوَ","s":3230,"f":4060},{"a":"ٱلْأَبْتَرُ","t":"l-abtaru","e":"the one cut off","j":[["ٱ","ham_wasl"],["لۡأَ"],["بۡ","qalaqah"],["تَرُ"]],"s":4070,"f":6010}],"p":602}]}