<?xml version="1.0" encoding="UTF-8"?>
<!-- Illustrative encoding of Regulation (EU) 2022/2554 (DORA): Art. 6(1), Art. 16(1), Art. 26(1), Art. 19(1).
     Simplifications are listed in REPORT.md. Not legal advice. -->
<lrml:LegalRuleML xmlns:lrml="http://docs.oasis-open.org/legalruleml/ns/v1.0/" xmlns:ruleml="http://ruleml.org/spec">
  <lrml:Statements key="dora">
    <!-- Art. 6(1): full ICT risk management framework -->
    <lrml:PrescriptiveStatement key="art6_1">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:Atom><ruleml:Rel iri=":financialEntity"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:if>
        <ruleml:then><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":fullIctFramework"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></lrml:Obligation></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <!-- Art. 16(1) first subparagraph: Articles 5 to 15 do not apply to the listed small entities (a derogation) -->
    <lrml:PrescriptiveStatement key="art16_1_exempt">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:Atom><ruleml:Rel iri=":art16Entity"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:if>
        <ruleml:then><lrml:Permission><ruleml:Neg><ruleml:Atom><ruleml:Rel iri=":fullIctFramework"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:Neg></lrml:Permission></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <!-- Art. 16(1) second subparagraph: simplified framework instead -->
    <lrml:PrescriptiveStatement key="art16_1_simplified">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:Atom><ruleml:Rel iri=":art16Entity"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:if>
        <ruleml:then><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":simplifiedIctFramework"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></lrml:Obligation></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <!-- Art. 26(1): threat-led penetration testing for identified entities, other than Art. 16(1) entities and microenterprises -->
    <lrml:PrescriptiveStatement key="art26_1">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:And>
          <ruleml:Atom><ruleml:Rel iri=":financialEntity"/><ruleml:Var>E</ruleml:Var></ruleml:Atom>
          <ruleml:Atom><ruleml:Rel iri=":identifiedForTlpt"/><ruleml:Var>E</ruleml:Var></ruleml:Atom>
        </ruleml:And></ruleml:if>
        <ruleml:then><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":tlpt"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></lrml:Obligation></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="art26_1_not_art16">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:Atom><ruleml:Rel iri=":art16Entity"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:if>
        <ruleml:then><lrml:Permission><ruleml:Neg><ruleml:Atom><ruleml:Rel iri=":tlpt"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:Neg></lrml:Permission></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="art26_1_not_micro">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:Atom><ruleml:Rel iri=":microenterprise"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:if>
        <ruleml:then><lrml:Permission><ruleml:Neg><ruleml:Atom><ruleml:Rel iri=":tlpt"/><ruleml:Var>E</ruleml:Var></ruleml:Atom></ruleml:Neg></lrml:Permission></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <!-- Art. 19(1): report major ICT-related incidents -->
    <lrml:PrescriptiveStatement key="art19_1">
      <ruleml:Rule><lrml:hasStrength><lrml:DefeasibleStrength/></lrml:hasStrength>
        <ruleml:if><ruleml:And>
          <ruleml:Atom><ruleml:Rel iri=":financialEntity"/><ruleml:Var>E</ruleml:Var></ruleml:Atom>
          <ruleml:Atom><ruleml:Rel iri=":majorIncident"/><ruleml:Var>E</ruleml:Var><ruleml:Var>I</ruleml:Var></ruleml:Atom>
        </ruleml:And></ruleml:if>
        <ruleml:then><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":reportIncident"/><ruleml:Var>E</ruleml:Var><ruleml:Var>I</ruleml:Var></ruleml:Atom></lrml:Obligation></ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:OverrideStatement><lrml:Override over="#art16_1_exempt" under="#art6_1"/></lrml:OverrideStatement>
    <lrml:OverrideStatement><lrml:Override over="#art26_1_not_art16" under="#art26_1"/></lrml:OverrideStatement>
    <lrml:OverrideStatement><lrml:Override over="#art26_1_not_micro" under="#art26_1"/></lrml:OverrideStatement>
  </lrml:Statements>
</lrml:LegalRuleML>
